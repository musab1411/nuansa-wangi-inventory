# Salin file ini jadi ".env" lalu pilih backend database.
#
# =====================================================================
# PILIH BACKEND
#   DB_BACKEND=postgres  -> Supabase / PostgreSQL (default)
#   DB_BACKEND=mysql     -> MySQL 8.0+ lokal (Laragon / XAMPP)
# Kalau DB_BACKEND dikosongkan: DATABASE_URL ada -> postgres, tidak ada -> mysql.
# =====================================================================
DB_BACKEND=postgres

# ---------------------------------------------------------------------
# BACKEND POSTGRES (Supabase)
#   Dashboard -> tombol "Connect" -> "Session pooler" -> salin URI-nya
#
# Format Session pooler (IPv4, port 5432):
#   postgresql://postgres.<PROJECT-REF>:<PASSWORD>@aws-<N>-<REGION>.pooler.supabase.com:5432/postgres
#
# TIPS: pakai password database yang cuma huruf+angka (reset di Project Settings -> Database)
#       supaya tidak perlu URL-encode karakter spesial seperti @ # $ / :
# ---------------------------------------------------------------------
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxxxxxx:GANTI_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require

# ---------------------------------------------------------------------
# BACKEND MYSQL (Laragon)
#   1. Laragon -> Start All (MySQL 8.0)
#   2. Jalankan database/schema.mysql.sql (phpMyAdmin / HeidiSQL)
#   3. Set DB_BACKEND=mysql di atas
#   Default Laragon: user root, password kosong, port 3306.
# ---------------------------------------------------------------------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=nuansa_wangi

# (opsional, berlaku untuk kedua backend)
DB_POOL_MIN=2
DB_POOL_MAX=10
# Maks. menunggu koneksi bebas dari pool (detik). Naikkan kalau database jauh/lambat.
DB_POOL_TIMEOUT=10
LOCK_TIMEOUT_MS=5000
