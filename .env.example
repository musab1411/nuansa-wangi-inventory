# Salin file ini jadi ".env" lalu isi DATABASE_URL dari Supabase:
#   Dashboard -> tombol "Connect" (atas) -> "Session pooler" -> salin URI-nya
#
# Format Session pooler (IPv4, port 5432):
#   postgresql://postgres.<PROJECT-REF>:<PASSWORD>@aws-<N>-<REGION>.pooler.supabase.com:5432/postgres
#
# TIPS: pakai password database yang cuma huruf+angka (reset di Project Settings -> Database)
#       supaya tidak perlu URL-encode karakter spesial seperti @ # $ / :
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxxxxxx:GANTI_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require

# (opsional)
DB_POOL_MIN=2
DB_POOL_MAX=10
LOCK_TIMEOUT_MS=5000
